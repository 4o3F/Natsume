# Public settings only. Copy outside the repository and set NATSUME_BENCH_ENV.
# Shell-style KEY=value, with quoted spaces; no shell expansion or commands.
# Same-named environment variables override this file. Every field is required.
NATSUME_BENCH_A=bench@192.0.2.10
NATSUME_BENCH_B=bench@192.0.2.20
NATSUME_BENCH_VM_ROOT=/srv/bench-vm
NATSUME_BENCH_RUN_ROOT=/home/bench/bench-control
# On B: control-ca.crt and operator-password; keep their contents on B.
NATSUME_BENCH_AUTH_DIR=/home/bench/bench-control/auth
NATSUME_BENCH_SERVER_URL=https://192.0.2.10:8443
NATSUME_BENCH_ADMIN_LOGIN=synthetic-admin
NATSUME_BENCH_VM1=station01
NATSUME_BENCH_VM2=station02
# Obtain actual UUIDs from your own Server's registered device list.
NATSUME_BENCH_DEVICE1=11111111-1111-4111-8111-111111111111
NATSUME_BENCH_DEVICE2=22222222-2222-4222-8222-222222222222
NATSUME_BENCH_SEAT1=S00000
NATSUME_BENCH_SEAT2=S00001
# On A: isolated bench data and the synthetic logo used for C5.
NATSUME_BENCH_SERVER_DATA=/srv/bench-server/data
NATSUME_BENCH_SERVER_LOGO='/srv/bench-server/data/organization-logos/Synthetic School 00001.webp'
# Select valid host CPU/NUMA resources; these retain the experiment's VM affinity.
NATSUME_BENCH_CPUSET=0-3
NATSUME_BENCH_NUMA_NODE=0
NATSUME_BENCH_OVMF_CODE=/usr/share/OVMF/OVMF_CODE_4M.fd
NATSUME_BENCH_SSH_PORT_BASE=2220
NATSUME_BENCH_VNC_DISPLAY_BASE=10
NATSUME_BENCH_MAC_PREFIX=52:54:00:62:00
# Separate loopback listeners used only while installing a template.
NATSUME_BENCH_TEMPLATE_SSH_PORT=2222
NATSUME_BENCH_TEMPLATE_VNC_DISPLAY=1
