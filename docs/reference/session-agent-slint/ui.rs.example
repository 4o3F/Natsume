#![forbid(unsafe_code)]

use std::cell::RefCell;

use slint::ComponentHandle;

slint::include_modules!();

thread_local! {
    static WINDOW: RefCell<Option<SessionWindow>> = const { RefCell::new(None) };
}

#[derive(Debug, Clone)]
pub enum UiUpdate {
    Hidden,
    Message {
        title: String,
        message: String,
        seat_input_visible: bool,
    },
}

pub fn apply(update: UiUpdate) -> Result<(), slint::PlatformError> {
    WINDOW.with(|slot| {
        let mut slot = slot.borrow_mut();
        match update {
            UiUpdate::Hidden => {
                if let Some(window) = slot.as_ref() {
                    window.hide()?;
                }
            }
            UiUpdate::Message {
                title,
                message,
                seat_input_visible,
            } => {
                let window = match slot.as_ref() {
                    Some(window) => window.clone_strong(),
                    None => {
                        let window = SessionWindow::new()?;
                        window.on_cancel({
                            let weak = window.as_weak();
                            move || {
                                if let Some(window) = weak.upgrade() {
                                    let _ = window.hide();
                                }
                            }
                        });
                        *slot = Some(window.clone_strong());
                        window
                    }
                };
                window.set_title_text(title.into());
                window.set_message_text(message.into());
                window.set_seat_input_visible(seat_input_visible);
                window.show()?;
            }
        }
        Ok(())
    })
}
