import { Button, HorizontalBox, LineEdit, VerticalBox } from "std-widgets.slint";

export component SessionWindow inherits Window {
    in property <bool> waiting-visible: true;
    in property <image> waiting-logo;
    in property <string> title-text: "Natsume";
    in property <string> message-text: "";
    in property <string> screen-kind-text: "";
    in property <bool> seat-input-visible: false;
    in-out property <string> seat-code: "";

    callback confirm-seat(string);

    title: root.title-text;
    preferred-width: 600px;
    preferred-height: 360px;
    no-frame: true;
    background: root.waiting-visible ? black : white;

    if root.waiting-visible: Image {
        width: root.width;
        height: root.height;
        source: root.waiting-logo;
        image-fit: contain;
    }

    if !root.waiting-visible: VerticalBox {
        width: root.width;
        height: root.height;
        padding: 24px;
        spacing: 14px;

        Text {
            text: root.title-text;
            font-size: 28px;
            font-weight: 700;
            wrap: word-wrap;
        }

        Text {
            text: root.screen-kind-text;
            font-size: 14px;
        }

        Text {
            text: root.message-text;
            font-size: 20px;
            wrap: word-wrap;
        }

        LineEdit {
            visible: root.seat-input-visible;
            text <=> root.seat-code;
            placeholder-text: "Seat";
            accepted => {
                root.confirm-seat(self.text);
            }
        }

        HorizontalBox {
            spacing: 12px;

            Button {
                visible: root.seat-input-visible;
                text: "Confirm";
                clicked => {
                    root.confirm-seat(root.seat-code);
                }
            }
        }
    }
}
