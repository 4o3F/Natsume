import { HorizontalBox, ScrollView, VerticalBox } from "std-widgets.slint";

export component SessionWindow inherits Window {
    in property <bool> waiting-visible: true;
    in property <image> waiting-logo;
    in property <bool> team-visible: false;
    in property <image> school-logo: @image-url("school.svg");
    in property <string> school-primary;
    in property <string> school-secondary;
    in property <string> team-primary;
    in property <string> team-secondary;
    in property <string> assigned-seat;
    in property <bool> long-team: false;
    in property <bool> long-seat: false;
    in property <bool> offline: true;
    in property <string> title-text: "Natsume";
    in property <string> message-text: "";
    in property <string> subtitle-text: "";
    in property <string> binding-error-text: "";
    in property <bool> binding-pending: false;
    in property <bool> seat-input-visible: false;
    in-out property <string> seat-code: "";

    callback confirm-seat(string);

    title: root.title-text;
    preferred-width: 600px;
    preferred-height: 360px;
    no-frame: true;
    background: root.team-visible || root.waiting-visible ? black : #f5f5f4;

    if root.waiting-visible && !root.team-visible: Image {
        width: root.width;
        height: root.height;
        source: root.waiting-logo;
        image-fit: contain;
    }

    if root.team-visible: profile := Rectangle {
        x: root.width * 0.07;
        y: max(144px, root.height * 0.035 + 126px);
        width: root.width * 0.86;
        height: root.height - self.y - min(48px, root.height * 0.05);
        background: black;

        school-view := ScrollView {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: footer.y - 32px;
            viewport-width: self.visible-width;
            VerticalBox {
                padding: 0px;
                x: 0px;
                y: 0px;
                width: school-view.visible-width;
                height: max(school-view.visible-height, self.preferred-height);
                alignment: center;
                spacing: 0px;
                HorizontalBox {
                    padding: 0px;
                    height: min(384px, root.width * 0.24, school-view.height * 0.68);
                    alignment: center;
                    Image {
                        width: parent.height;
                        height: parent.height;
                        source: root.school-logo;
                        image-fit: contain;
                    }
                }
                VerticalBox {
                    padding: 0px;
                    padding-top: 24px;
                    spacing: 8px;
                    vertical-stretch: 0;
                    Text {
                        text: root.school-primary;
                        color: #f5f5f5;
                        font-size: min(30px, max(24px, root.height * 0.033));
                        font-weight: 500;
                        horizontal-alignment: center;
                        vertical-stretch: 0;
                        wrap: word-wrap;
                    }
                    Text {
                        visible: root.school-secondary != "";
                        text: root.school-secondary;
                        color: #a3a3a3;
                        font-size: 16px;
                        horizontal-alignment: center;
                        vertical-stretch: 0;
                        wrap: word-wrap;
                    }
                }
            }
        }

        footer := Rectangle {
            y: parent.height - self.height;
            width: parent.width;
            height: min(root.height * 0.38, max(root.height * 0.16,
                max(team-title.preferred-height + (root.team-secondary == "" ? 0px : team-subtitle.preferred-height + 12px),
                    seat-label.preferred-height + seat-number.preferred-height + 16px)
                + footer-padding));
            property <length> footer-padding: min(40px, root.height * 0.045);
            property <length> seat-width: self.width * 0.3;
            background: black;
            Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px; background: #171717; }

            team-view := ScrollView {
                x: 0px;
                y: footer.footer-padding;
                width: parent.width - footer.seat-width - root.width * 0.04;
                height: parent.height - self.y;
                viewport-width: self.visible-width;
                VerticalBox {
                    padding: 0px;
                    x: 0px;
                    y: 0px;
                    width: team-view.visible-width;
                    height: max(team-view.visible-height, self.preferred-height);
                    alignment: end;
                    spacing: 12px;
                    team-title := Text {
                        text: root.team-primary;
                        color: #f5f5f5;
                        font-size: root.long-team ? min(28px, root.height * 0.034) : min(48px, max(32px, root.height * 0.052));
                        font-weight: 600;
                        vertical-stretch: 0;
                        wrap: word-wrap;
                    }
                    team-subtitle := Text {
                        visible: root.team-secondary != "";
                        text: root.team-secondary;
                        color: #a3a3a3;
                        font-size: min(20px, max(16px, root.height * 0.022));
                        vertical-stretch: 0;
                        wrap: word-wrap;
                    }
                }
            }

            VerticalBox {
                padding: 0px;
                x: parent.width - self.width;
                y: footer.footer-padding;
                width: footer.seat-width;
                height: parent.height - self.y;
                alignment: end;
                spacing: 16px;
                seat-label := Text {
                    text: "座位 / SEAT";
                    color: #a3a3a3;
                    font-size: 12px;
                    horizontal-alignment: right;
                    vertical-stretch: 0;
                }
                seat-number := Text {
                    text: root.assigned-seat;
                    color: #f5f5f5;
                    font-size: root.long-seat ? 24px : min(72px, max(48px, root.height * 0.08));
                    font-weight: 500;
                    horizontal-alignment: right;
                    vertical-stretch: 0;
                    wrap: word-wrap;
                }
            }
        }
    }

    if !root.waiting-visible && !root.team-visible: binding-page := Rectangle {
        width: root.width;
        height: root.height;
        background: #f5f5f4;
        Text {
            x: root.width * 0.03;
            y: 36px;
            text: "NATSUME";
            color: #78716c;
            font-size: 14px;
            font-weight: 600;
            letter-spacing: 1px;
        }
        body := Rectangle {
            width: min(1152px, root.width * 0.88);
            height: max(introduction.preferred-height, input-card.height);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            property <length> column-gap: min(96px, root.width * 0.06);
            property <length> column-width: (self.width - self.column-gap) / 2;

            introduction := VerticalBox {
                x: 0px;
                y: (parent.height - self.height) / 2;
                width: body.column-width;
                height: self.preferred-height;
                padding: 0px;
                spacing: 0px;
                Rectangle {
                    height: 80px;
                    Rectangle {
                        x: 0px;
                        y: 0px;
                        width: 80px;
                        height: 80px;
                        border-radius: 24px;
                        background: #e7e5e4;
                        Image { width: 32px; height: 32px; source: @image-url("seat.svg"); }
                    }
                }
                Rectangle { height: 32px; }
                Text { text: "座位设置 / SEAT SETUP"; color: #78716c; font-size: 14px; vertical-stretch: 0; }
                Rectangle { height: 20px; }
                Text {
                    text: root.title-text;
                    color: #1c1917;
                    font-size: min(48px, root.width * 0.034);
                    font-weight: 500;
                    vertical-stretch: 0;
                    wrap: word-wrap;
                }
                Rectangle { height: 16px; }
                Text { text: root.subtitle-text; color: #78716c; font-size: 20px; vertical-stretch: 0; wrap: word-wrap; }
                Rectangle { height: 32px; }
                Text { text: root.message-text; color: #78716c; font-size: 16px; vertical-stretch: 0; wrap: word-wrap; }
            }

            input-card := Rectangle {
                x: parent.width - self.width;
                y: (parent.height - self.height) / 2;
                width: body.column-width;
                height: root.binding-pending ? 320px : form.preferred-height + 2 * self.inset;
                property <length> inset: min(40px, root.width * 0.032);
                background: #fdfdfc;
                border-color: #e7e5e4;
                border-width: 1px;
                border-radius: 24px;

                form := VerticalBox {
                    visible: !root.binding-pending;
                    x: input-card.inset;
                    y: input-card.inset;
                    width: parent.width - 2 * input-card.inset;
                    height: self.preferred-height;
                    padding: 0px;
                    spacing: 16px;
                    Text { text: "座位号 / SEAT CODE"; color: #57534e; font-size: 14px; vertical-stretch: 0; }
                    input-border := Rectangle {
                        height: 80px;
                        background: white;
                        border-width: seat-input.has-focus || root.binding-error-text != "" ? 2px : 1px;
                        border-color: root.binding-error-text != "" ? #fb7185 : seat-input.has-focus ? #78716c : #d6d3d1;
                        border-radius: 16px;
                        Rectangle {
                            x: 24px;
                            y: 8px;
                            width: parent.width - 48px;
                            height: parent.height - 16px;
                            clip: true;
                            Text {
                                visible: root.seat-code == "" && seat-input.preedit-text == "";
                                x: 0px;
                                width: parent.width;
                                height: parent.height;
                                text: "例如 A-108";
                                color: #a8a29e;
                                font-size: 28px;
                                vertical-alignment: center;
                            }
                            ContextMenuArea {
                                enabled: root.seat-input-visible;
                                Menu {
                                    MenuItem { title: "剪切 / Cut"; activated => { seat-input.cut(); } }
                                    MenuItem { title: "复制 / Copy"; activated => { seat-input.copy(); } }
                                    MenuItem { title: "粘贴 / Paste"; activated => { seat-input.paste(); } }
                                    MenuItem { title: "全选 / Select all"; activated => { seat-input.select-all(); } }
                                }
                                seat-input := TextInput {
                                    property <length> cursor-offset: 0px;
                                    x: min(0px, max(parent.width - self.width - self.text-cursor-width, self.cursor-offset));
                                    width: max(parent.width - self.text-cursor-width, self.preferred-width);
                                    height: parent.height;
                                    text <=> root.seat-code;
                                    color: #1c1917;
                                    font-size: 30px;
                                    font-weight: 500;
                                    single-line: true;
                                    vertical-alignment: center;
                                    selection-background-color: #44403c;
                                    selection-foreground-color: white;
                                    enabled: root.seat-input-visible;
                                    accessible-label: "座位号 / Seat code";
                                    accessible-placeholder-text: "例如 A-108";
                                    init => { if (self.enabled) { self.focus(); } }
                                    changed enabled => { if (self.enabled) { self.focus(); } }
                                    cursor-position-changed(position) => {
                                        if (position.x + self.cursor-offset < 0px) { self.cursor-offset = -position.x; }
                                        if (position.x + self.cursor-offset > parent.width - self.text-cursor-width) {
                                            self.cursor-offset = parent.width - self.text-cursor-width - position.x;
                                        }
                                    }
                                    accepted => { if (root.seat-input-visible && root.seat-code != "") { root.confirm-seat(self.text); } }
                                }
                            }
                        }
                    }
                    if root.binding-error-text != "": Rectangle {
                        height: error-label.preferred-height + 24px;
                        background: #fff1f2;
                        border-color: #fecdd3;
                        border-width: 1px;
                        border-radius: 12px;
                        error-label := Text {
                            x: 12px;
                            y: 12px;
                            width: parent.width - 24px;
                            text: root.binding-error-text;
                            color: #be123c;
                            font-size: 14px;
                            wrap: word-wrap;
                        }
                    }
                    confirm-button := Rectangle {
                        height: 64px;
                        property <bool> enabled: root.seat-input-visible && root.seat-code != "";
                        background: !self.enabled ? #d6d3d1 : button-touch.pressed ? #1c1917 : button-touch.has-hover ? #44403c : #292524;
                        border-radius: 16px;
                        border-width: button-focus.has-focus ? 2px : 0px;
                        border-color: #a8a29e;
                        accessible-role: button;
                        accessible-enabled: self.enabled;
                        accessible-label: "确认绑定";
                        accessible-action-default => { if (self.enabled) { root.confirm-seat(root.seat-code); } }
                        Text {
                            text: "确认绑定  →";
                            color: confirm-button.enabled ? white : #78716c;
                            font-size: 16px;
                            font-weight: 500;
                        }
                        button-touch := TouchArea {
                            enabled: confirm-button.enabled;
                            clicked => { button-focus.focus(); root.confirm-seat(root.seat-code); }
                        }
                        button-focus := FocusScope {
                            width: 0px;
                            enabled: confirm-button.enabled;
                            key-pressed(event) => {
                                if (event.text == " " || event.text == "\n") { root.confirm-seat(root.seat-code); return accept; }
                                return reject;
                            }
                        }
                    }
                    Text {
                        text: "座位号不确定时，请联系现场工作人员";
                        color: #78716c;
                        font-size: 14px;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                        vertical-stretch: 0;
                    }
                }
                if root.binding-pending: VerticalBox {
                    padding: 32px;
                    alignment: center;
                    spacing: 16px;
                    HorizontalBox {
                        padding: 0px;
                        alignment: center;
                        height: 64px;
                        Rectangle {
                            width: 64px;
                            height: 64px;
                            border-radius: 32px;
                            background: #f5f5f4;
                            Image { width: 32px; height: 32px; source: @image-url("binding-pending.svg"); }
                        }
                    }
                    Text { text: "正在等待确认，请稍候"; color: #44403c; font-size: 16px; horizontal-alignment: center; vertical-stretch: 0; }
                    Text { text: "确认后将显示对应队伍信息"; color: #78716c; font-size: 14px; horizontal-alignment: center; wrap: word-wrap; vertical-stretch: 0; }
                }
            }
        }
    }
    if root.waiting-visible || root.team-visible: Rectangle {
        x: root.width * 0.035;
        y: max(18px, root.height * 0.035);
        width: 320px;
        height: 36px;
        brand := Text {
            x: 0px;
            y: (parent.height - self.height) / 2;
            width: self.preferred-width;
            height: self.preferred-height;
            text: "Natsume";
            color: #e5e5e5;
            font-size: 28px;
            font-weight: 600;
        }
        Text {
            x: brand.x + brand.width + 12px;
            y: brand.y + brand.font-metrics.ascent - self.font-metrics.ascent;
            width: self.preferred-width;
            height: self.preferred-height;
            text: "· by 4o3F";
            color: #a3a3a3;
            font-size: 18px;
        }
    }
    if root.offline: Rectangle {
        x: root.width - self.width - root.width * 0.035;
        y: max(18px, root.height * 0.035);
        width: 164px;
        height: 24px;
        background: transparent;
        HorizontalBox {
            padding: 0px;
            spacing: 8px;
            alignment: end;
            Image {
                width: 16px;
                height: 16px;
                source: @image-url("offline.svg");
                colorize: root.waiting-visible || root.team-visible ? #fbbf24 : #b45309;
                image-fit: contain;
            }
            Text {
                text: "离线 / Offline";
                color: root.waiting-visible || root.team-visible ? #fbbf24 : #b45309;
                font-size: 14px;
            }
        }
    }
}
