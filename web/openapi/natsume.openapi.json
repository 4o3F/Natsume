{
  "openapi": "3.1.0",
  "info": {
    "title": "Natsume V2",
    "description": "Rust-owned Phase 0 API contract. Version 2.5.0 is the retained API skeleton baseline and is independent of the 2.0.0 package version. The Phase 0 blueprint router exposes only GET /api/v2/health; imports, enrollment-request approval and declarative Command submission are frozen contracts, not currently mounted runtime routes. Catalogue routes in the architecture do not replace them implicitly.",
    "license": {
      "name": "AGPL-3.0-or-later",
      "identifier": "AGPL-3.0-or-later"
    },
    "version": "2.5.0"
  },
  "paths": {
    "/api/v2/commands/{command_id}": {
      "put": {
        "tags": [],
        "summary": "Persist a Panel-generated Command",
        "description": "The Control Panel generates command_id before submission. It must be a canonical lowercase hyphenated UUIDv7. Retrying the same command_id with the same normalized request returns the persisted Command; a different request for that ID conflicts. A persisted response never represents Device execution.",
        "operationId": "putCommand",
        "parameters": [
          {
            "name": "command_id",
            "in": "path",
            "description": "Panel-generated canonical lowercase hyphenated UUIDv7 Command identifier",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "example": "018f0e2e-8c1d-7c5e-8b12-3456789abcde"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PutCommandRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The same command_id and normalized request replayed an existing persisted Command; Device execution is not implied.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PersistedCommandResponse"
                }
              }
            }
          },
          "201": {
            "description": "The Command was persisted for the first time; Device execution is not implied.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PersistedCommandResponse"
                }
              }
            }
          },
          "400": {
            "description": "The command_id is not a canonical lowercase hyphenated UUIDv7 (COMMAND_ID_INVALID). The response never echoes the invalid value.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenApiProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "The command_id is already bound to a different normalized request (COMMAND_REQUEST_CONFLICT).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenApiProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/enrollment-requests/{request_id}/actions/approve": {
      "post": {
        "tags": [],
        "summary": "Approve Device Enrollment for Device Token-authenticated WSS control",
        "operationId": "approveEnrollment",
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "description": "Enrollment request identifier",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Enrollment approval accepted; the provisioning-window Enrollment transaction issues the Device Token and Gateway certificate (ADR-0033)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnrollmentApprovalAccepted"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/health": {
      "get": {
        "tags": [],
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Server process is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/imports": {
      "post": {
        "tags": [],
        "summary": "Upload one authoritative seat/account/password CSV",
        "operationId": "createCsvImport",
        "responses": {
          "202": {
            "description": "Import staged for masked preview"
          }
        }
      }
    },
    "/api/v2/imports/{import_id}/actions/commit": {
      "post": {
        "tags": [],
        "operationId": "commitCsvImport",
        "parameters": [
          {
            "name": "import_id",
            "in": "path",
            "description": "CSV import identifier",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Atomic domain commit; no device sync is implied"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CommandKind": {
        "type": "string",
        "description": "The only Panel-command kinds frozen by the Phase 0 HTTP contract.\n\nDevice-facing payloads remain bounded by this enum; arbitrary remote-management commands are\nintentionally not representable.",
        "enum": ["sync_state", "sync_secret"]
      },
      "CommandPersistenceState": {
        "type": "string",
        "description": "The persistence state returned by the Command endpoint.\n\nThis is deliberately not a Device execution outcome.",
        "enum": ["persisted"]
      },
      "EnrollmentApprovalAccepted": {
        "type": "object",
        "required": ["enrollment_request_id", "certificate_scope"],
        "properties": {
          "certificate_scope": {
            "type": "string"
          },
          "enrollment_request_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "OpenApiProblemDetails": {
        "type": "object",
        "required": ["type", "title", "status", "code", "correlation_id"],
        "properties": {
          "code": {
            "type": "string"
          },
          "correlation_id": {
            "type": "string",
            "format": "uuid"
          },
          "detail": {
            "type": ["string", "null"]
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        }
      },
      "PersistedCommandResponse": {
        "type": "object",
        "description": "A Command accepted into durable Server storage.",
        "required": ["command_id", "device_id", "kind", "state"],
        "properties": {
          "command_id": {
            "type": "string",
            "format": "uuid",
            "example": "018f0e2e-8c1d-7c5e-8b12-3456789abcde",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "device_id": {
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/CommandKind"
          },
          "state": {
            "$ref": "#/components/schemas/CommandPersistenceState"
          }
        }
      },
      "PutCommandRequest": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/SyncStateCommandRequest"
          },
          {
            "$ref": "#/components/schemas/SyncSecretCommandRequest"
          }
        ],
        "description": "Persisted request data supplied by the Control Panel.\n\nEach `kind` has a separate closed object, so unknown or cross-kind input is rejected."
      },
      "SyncSecretCommandInput": {
        "type": "object",
        "description": "No secret material is accepted from the Panel. The Server resolves it from the vault later.",
        "additionalProperties": false
      },
      "SyncSecretCommandKind": {
        "type": "string",
        "enum": ["sync_secret"]
      },
      "SyncSecretCommandRequest": {
        "type": "object",
        "required": [
          "kind",
          "device_id",
          "reason_code",
          "input_version",
          "input"
        ],
        "properties": {
          "device_id": {
            "type": "string"
          },
          "group_correlation_id": {
            "type": ["string", "null"]
          },
          "input": {
            "$ref": "#/components/schemas/SyncSecretCommandInput"
          },
          "input_version": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "kind": {
            "$ref": "#/components/schemas/SyncSecretCommandKind"
          },
          "reason_code": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "SyncStateCommandInput": {
        "type": "object",
        "description": "No caller-controlled state payload is accepted. The Server derives it from current truth.",
        "additionalProperties": false
      },
      "SyncStateCommandKind": {
        "type": "string",
        "enum": ["sync_state"]
      },
      "SyncStateCommandRequest": {
        "type": "object",
        "required": [
          "kind",
          "device_id",
          "reason_code",
          "input_version",
          "input"
        ],
        "properties": {
          "device_id": {
            "type": "string"
          },
          "group_correlation_id": {
            "type": ["string", "null"]
          },
          "input": {
            "$ref": "#/components/schemas/SyncStateCommandInput"
          },
          "input_version": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "kind": {
            "$ref": "#/components/schemas/SyncStateCommandKind"
          },
          "reason_code": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
