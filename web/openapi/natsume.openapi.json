          },
          "403": {
            "description": "Administrator role required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "sessionCookie": []
          }
        ]
      }
    },
    "/api/v2/provisioning-window/actions/open": {
      "post": {
        "operationId": "openProvisioningWindow",
        "responses": {
          "200": {
            "description": "Provisioning window opened or already open",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProvisioningWindowResponse"
                }
              }
            }
          },
          "401": {
            "description": "Session authentication failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Administrator role required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "sessionCookie": []
          }
        ]
      }
    },
    "/api/v2/seats": {
      "get": {
        "operationId": "listSeats",
        "responses": {
          "200": {
            "description": "Current Seat set",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SeatResponse"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Session authentication failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "sessionCookie": []
          }
        ]
      }
    },
    "/api/v2/session": {
      "get": {
        "operationId": "getSession",
        "responses": {
          "200": {
            "description": "Current session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          },
          "401": {
            "description": "Session authentication failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "sessionCookie": []
          }
        ]
      },
      "post": {
        "operationId": "createSession",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SessionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Session established",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid closed request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authentication failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "Request body exceeds the session ingress limit"
          },
          "500": {
            "description": "Internal failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteSession",
        "responses": {
          "204": {
            "description": "Session terminated or credential-state no-op"
          },
          "500": {
            "description": "Session termination infrastructure failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "sessionCookie": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AccountResponse": {
        "type": "object",
        "required": ["account_id", "domjudge_username", "credential_revision"],
        "properties": {
          "account_id": {
            "type": "string"
          },
          "credential_revision": {
            "type": "integer",
            "format": "int64"
          },
          "domjudge_username": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "BindingResponse": {
        "type": "object",
        "required": ["binding_id", "seat_id", "device_id"],
        "properties": {
          "binding_id": {
            "type": "string"
          },
          "device_id": {
            "type": "string"
          },
          "seat_id": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "CanonicalUuidV7": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["title", "status", "code"],
        "properties": {
          "code": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "HealthResponse": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "ImportBindingImpactResponse": {
        "type": "object",
        "required": ["seat_code", "device_id"],
        "properties": {
          "device_id": {
            "type": "string"
          },
          "seat_code": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "ImportCommitRequest": {
        "type": "object",
        "required": ["preview_token", "csv"],
        "properties": {
          "csv": {
            "type": "string",
            "description": "The same seat/account candidate reviewed in preview, with the passwords\nsupplied again because preview never persists them.",
            "writeOnly": true
          },
          "preview_token": {
            "type": "string",
            "writeOnly": true,
            "maxLength": 43,
            "minLength": 43,
            "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
          }
        },
        "additionalProperties": false
      },
      "ImportMappingChangeResponse": {
        "type": "object",
        "required": [
          "seat_code",
          "current_domjudge_username",
          "candidate_domjudge_username"
        ],
        "properties": {
          "candidate_domjudge_username": {
            "type": "string"
          },
          "current_domjudge_username": {
            "type": ["string", "null"]
          },
          "seat_code": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "ImportPendingResponse": {
        "type": "object",
        "required": ["pending"],
        "properties": {
          "pending": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ImportPendingSummary"
              }
            ]
          }
        },
        "additionalProperties": false
      },
      "ImportPendingSummary": {
        "type": "object",
        "required": ["candidate_id", "expires_at_unix_ms", "diff"],
        "properties": {
          "candidate_id": {
            "$ref": "#/components/schemas/CanonicalUuidV7"
          },
          "diff": {
            "$ref": "#/components/schemas/ImportRedactedDiff"
          },
          "expires_at_unix_ms": {
            "type": "integer",
            "format": "int64"
          }
        },
        "additionalProperties": false
      },
      "ImportPreviewResponse": {
        "type": "object",
        "required": [
          "candidate_id",
          "preview_token",
          "expires_at_unix_ms",
          "diff"
        ],
        "properties": {
          "candidate_id": {
            "$ref": "#/components/schemas/CanonicalUuidV7"
          },
          "diff": {
            "$ref": "#/components/schemas/ImportRedactedDiff"
          },
          "expires_at_unix_ms": {
            "type": "integer",
            "format": "int64"
          },
          "preview_token": {
            "type": "string",
            "maxLength": 43,
            "minLength": 43,
            "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
          }
        },
        "additionalProperties": false
      },
      "ImportRedactedDiff": {
        "type": "object",
        "required": [
          "seats_added",
          "seats_removed",
          "mappings_changed",
          "unchanged_count",
          "affected_account_count",
          "binding_impacts"
        ],
        "properties": {
          "affected_account_count": {
            "type": "integer",
            "minimum": 0
          },
          "binding_impacts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ImportBindingImpactResponse"
            }
          },
          "mappings_changed": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ImportMappingChangeResponse"
            }
          },
          "seats_added": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "seats_removed": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "unchanged_count": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "ProvisioningWindowResponse": {
        "type": "object",
        "required": ["state"],
        "properties": {
          "state": {
            "type": "string",
            "enum": ["closed", "open"]
          }
        },
        "additionalProperties": false
      },
      "SeatResponse": {
        "type": "object",
        "required": ["seat_id", "seat_code"],
        "properties": {
          "seat_code": {
            "type": "string"
          },
          "seat_id": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "SessionRequest": {
        "type": "object",
        "required": ["login_name", "password"],
        "properties": {
          "login_name": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "writeOnly": true
          }
        },
        "additionalProperties": false
      },
      "SessionResponse": {
        "type": "object",
        "required": ["operator_id", "role"],
        "properties": {
          "operator_id": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Secure-natsume_session"
      }
    }
  }
}
