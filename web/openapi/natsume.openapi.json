    "/api/v2/commands/{command_id}": {
      "put": {
        "summary": "Create or replay a direct Device Command",
        "description": "command_id must be a canonical lowercase hyphenated UUIDv7. The same canonical request, identified by its versioned domain-separated request fingerprint, replays the existing Command. A differing canonical request conflicts.",
        "operationId": "putCommand",
        "parameters": [
          {
            "name": "command_id",
            "in": "path",
            "description": "Canonical lowercase hyphenated UUIDv7 supplied by the Panel",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PutCommandRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Identical Command request replayed",
            "headers": {
              "X-Correlation-Id": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                },
                "description": "Server-generated canonical UUIDv7 correlation ID"
              }
            }
          },
          "201": {
            "description": "Command created",
            "headers": {
              "X-Correlation-Id": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                },
                "description": "Server-generated canonical UUIDv7 correlation ID"
              }
            }
          },
          "400": {
            "description": "Command ID is not canonical UUIDv7",
            "headers": {
              "X-Correlation-Id": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                },
                "description": "Server-generated canonical UUIDv7 correlation ID"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Session authentication failed",
            "headers": {
              "X-Correlation-Id": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                },
                "description": "Server-generated canonical UUIDv7 correlation ID"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Administrator role required",
            "headers": {
              "X-Correlation-Id": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                },
                "description": "Server-generated canonical UUIDv7 correlation ID"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Device does not exist",
            "headers": {
              "X-Correlation-Id": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                },
                "description": "Server-generated canonical UUIDv7 correlation ID"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Command request conflicts",
            "headers": {
              "X-Correlation-Id": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                },
                "description": "Server-generated canonical UUIDv7 correlation ID"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal failure",
            "headers": {
              "X-Correlation-Id": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                },
                "description": "Server-generated canonical UUIDv7 correlation ID"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "sessionCookie": []
          }
        ]
      }
    },
