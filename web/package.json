{
  "name": "@natsume/web",
  "description": "React and shadcn/ui operations panel for Natsume V2",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.1.0",
    "pnpm": ">=12 <13"
  },
  "scripts": {
