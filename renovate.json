{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":automergeMinor"
  ],
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "prConcurrentLimit": 30,
  "addLabels": ["bot:renovate"],
  "automergeType": "pr",
  "platformAutomerge": true,
  "rebaseWhen": "conflicted",
  "automergeStrategy": "squash",
  "packageRules": [
    {
      "description": "Wait two days before updating npm dependencies",
      "matchDatasources": ["npm"],
      "minimumReleaseAge": "2 days"
    },
    {
      "description": "Update the coupled Specta crates together",
      "matchManagers": ["cargo"],
      "matchPackageNames": [
        "specta",
        "specta-serde",
        "specta-typescript"
      ],
      "groupName": "specta",
      "separateMajorMinor": false
    },
    {
      "description": "Update the coupled Slint and Skia dependencies together",
      "matchManagers": ["cargo"],
      "matchPackageNames": [
        "slint",
        "slint-build",
        "skia-bindings"
      ],
      "groupName": "slint and skia",
      "separateMajorMinor": false
    },
    {
      "description": "Update the coupled Diesel and SQLite dependencies together",
      "matchManagers": ["cargo"],
      "matchPackageNames": [
        "diesel",
        "diesel_migrations",
        "libsqlite3-sys"
      ],
      "groupName": "diesel and sqlite",
      "separateMajorMinor": false
    },
    {
      "description": "Update OpenTelemetry and its tracing integration together",
      "matchManagers": ["cargo"],
      "matchPackageNames": [
        "opentelemetry",
        "opentelemetry_sdk",
        "opentelemetry-otlp",
        "tracing-opentelemetry"
      ],
      "groupName": "opentelemetry",
      "separateMajorMinor": false
    },
    {
      "description": "Update Rustls and the libraries sharing its TLS configuration together",
      "matchManagers": ["cargo"],
      "matchPackageNames": [
        "rustls",
        "rustls-pki-types",
        "tokio-rustls",
        "tokio-tungstenite",
        "reqwest"
      ],
      "groupName": "rustls integrations",
      "separateMajorMinor": false
    },
    {
      "description": "Update the coupled private-key format dependencies together",
      "matchManagers": ["cargo"],
      "matchPackageNames": [
        "pkcs5",
        "pkcs8",
        "sec1"
      ],
      "groupName": "private key formats",
      "separateMajorMinor": false
    }
  ]
}
