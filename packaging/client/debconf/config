#!/bin/sh
set -eu

case "${1:-configure}" in
    configure|reconfigure) ;;
    abort-*) exit 0 ;;
    *) exit 0 ;;
esac

. /usr/share/debconf/confmodule

db_input critical natsume-client/server-ip || true
db_input critical natsume-client/server-port || true
# db_go is a zero-argument debconf protocol operation; package config arguments
# must not be forwarded to it.
# shellcheck disable=SC2119
db_go
