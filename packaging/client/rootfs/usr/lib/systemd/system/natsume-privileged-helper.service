[Unit]
Description=Natsume V2 Privileged Helper
After=dbus.service local-fs.target
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=dbus
BusName=org.natsume.Privileged1
ExecStart=/usr/lib/natsume/natsume-privileged-helper serve
ExecStopPost=/usr/lib/natsume/natsume-privileged-helper close-admission
Restart=on-failure
RestartSec=2s
User=root
PrivateNetwork=yes
# Home mounts must be visible in the host mount namespace.
PrivateMounts=no
# Pass the host namespace without granting the Helper CAP_SYS_PTRACE.
OpenFile=/proc/1/ns/mnt:host-mount-namespace:read-only
RestrictAddressFamilies=AF_UNIX
NoNewPrivileges=yes
LimitCORE=0
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_KILL CAP_SYS_ADMIN CAP_SETUID CAP_SETGID
# Preserve the fixed UID transition across systemd's seccomp setup and exec.
AmbientCapabilities=CAP_SETUID

[Install]
WantedBy=multi-user.target
