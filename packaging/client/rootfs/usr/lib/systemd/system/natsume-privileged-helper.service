[Unit]
Description=Natsume V2 Privileged Helper
After=dbus.service local-fs.target

[Service]
Type=dbus
BusName=org.natsume.Privileged1
ExecStart=/usr/lib/natsume/natsume-privileged-helper
User=root
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_SETGID CAP_SETUID CAP_SYS_ADMIN

[Install]
WantedBy=multi-user.target
