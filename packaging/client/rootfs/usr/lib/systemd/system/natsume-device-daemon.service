
[Unit]
Description=Natsume V2 Device Daemon
# udev-settle gates the first identity collection: the D-Bus-activated helper reads
# /run/udev/data for the root disk serial, and a first start before the udev database
# is populated would pin a two-slot identity that later recomputes as three slots.
After=network-online.target dbus.service local-fs.target systemd-udev-settle.service natsume-privileged-helper.service
Wants=network-online.target systemd-udev-settle.service
Requires=natsume-privileged-helper.service
ConditionPathExists=/etc/natsume/config.toml
ConditionPathExists=/etc/natsume/site.toml
ConditionPathExists=/etc/natsume/trust/control-ca.crt
ConditionPathExists=/etc/natsume/trust/local-origin-ca.crt

[Service]
Type=simple
User=natsume
SupplementaryGroups=natsume-gateway
ExecStart=/usr/bin/natsume-device-daemon
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/etc/natsume
ReadWritePaths=/var/lib/natsume /run/natsume
LimitCORE=0
Restart=on-failure

[Install]
WantedBy=multi-user.target
