
[Unit]
Description=Natsume V2 Local HTTPS Gateway
After=local-fs.target
Before=natsume-device-daemon.service

[Service]
Type=notify
User=natsume-caddy
Group=natsume-gateway
UMask=0007
ExecStart=/usr/lib/natsume/caddy run --config /etc/natsume/caddy/bootstrap.caddyfile --adapter caddyfile
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/run/natsume
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LimitCORE=0
Restart=on-failure
